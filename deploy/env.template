# ─── AutoClaw Environment Variables ─────────────────────────────────
# Copy to /etc/autoclaw/env and set values

# ── App Signing (REQUIRED in production) ──
AUTOCLAW_APP_KEY=

# ── Token Encryption (optional but recommended) ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOCLAW_TOKEN_KEY=

# ── Proxy Server ──
AUTOCLAW_PROXY_HOST=127.0.0.1
AUTOCLAW_PROXY_PORT=31000

# ── TLS Verification ──
AUTOCLAW_TLS_VERIFY=false

# ── Proxy API Key (optional auth for proxy itself) ──
AUTOCLAW_PROXY_API_KEY=

# ── Gunicorn ──
GUNICORN_WORKERS=2
GUNICORN_LOG_LEVEL=info

# ── Synergy 6: OWL-AGENT Proxy Defense Layer (v2.1.0) ──
# Proxy-first upstream routing with hedged racing + direct fallback.
OWL_PROXY_ENABLED=1
# OWL_HEDGE_FANOUT=3
# OWL_PROXY_TIMEOUT=6
# OWL_DIRECT_TIMEOUT=30
# OWL_TLS_IMPERSONATE=chrome110     # requires: pip install curl_cffi
# OWL_CACHE_TTL=0
# OWL_STARTUP_TIMEOUT=15
