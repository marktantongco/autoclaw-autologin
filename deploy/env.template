# ─── AutoClaw Environment Variables ─────────────────────────────────
# Copy to /etc/autoclaw/env and set values

# ── App Signing (REQUIRED in production) ──
AUTOCLAW_APP_KEY=

# ── Token Encryption (optional but recommended) ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOCLAW_TOKEN_KEY=

# ── Proxy Server ──
AUTOCLAW_PROXY_HOST=127.0.0.1
AUTOCLAW_PROXY_PORT=31000

# ── TLS Verification ──
AUTOCLAW_TLS_VERIFY=false

# ── Proxy API Key (optional auth for proxy itself) ──
AUTOCLAW_PROXY_API_KEY=

# ── Gunicorn ──
GUNICORN_WORKERS=2
GUNICORN_LOG_LEVEL=info

# ── Synergy 6: OWL-AGENT Proxy Defense Layer (v2.1.0) ──
# Proxy-first upstream routing with hedged racing + direct fallback.
OWL_PROXY_ENABLED=1
# OWL_HEDGE_FANOUT=3
# OWL_PROXY_TIMEOUT=6
# OWL_DIRECT_TIMEOUT=30
# OWL_TLS_IMPERSONATE=chrome110     # requires: pip install curl_cffi
# OWL_CACHE_TTL=0
# OWL_STARTUP_TIMEOUT=15

# ── Phase 2 (v2.2.0): DSML shim + fingerprint + loop_breaker ──
# DSML tool-calling shim (client `tools` synthesised into OpenAI tool_calls)
AUTOCLAW_DSML_ENABLED=1
# Per-chat fingerprint isolation (account affinity, anti conversation-merge)
AUTOCLAW_FINGERPRINT_ENABLED=1
# AUTOCLAW_FINGERPRINT_TTL=86400
# AUTOCLAW_FINGERPRINT_MAX=10000
# loop_breaker: 400s identical re-emits of a >=80%-context-full turn
AUTOCLAW_LOOP_BREAKER_ENABLED=1
# AUTOCLAW_LOOP_REEMITS=4
# AUTOCLAW_LOOP_RATIO=0.8
# AUTOCLAW_LOOP_TTL=3600
# AUTOCLAW_CONTEXT_WINDOW=            # global override (tokens)

# ── Phase 3 (v2.3.0): WS fallback + thermoptic + dashboard ──
# Synergy 13: cloud-to-local WebSocket fallback (requires a local AutoClaw
# desktop agent speaking protocol autoclaw-ws-agent-v1)
ACLAW_WS_FALLBACK=0
# ACLAW_WS_AGENT_URL=ws://127.0.0.1:18789/agent   # skip discovery when set
# ACLAW_WS_DISCOVERY_PORTS=18789,18790,18791
# ACLAW_WS_TIMEOUT=600
# ACLAW_WS_BREAKER_THRESHOLD=3
# ACLAW_WS_BREAKER_COOLDOWN=60
# Synergy 14 (via mandatoryprogrammer/thermoptic): real-browser JA4+
# camouflage egress tier — run deploy/thermoptic-README.md setup first
OWL_THERMOPTIC_ENABLED=0
# OWL_THERMOPTIC_URL=http://127.0.0.1:1234
# OWL_THERMOPTIC_CA=/path/to/thermoptic/ssl/rootCA.crt
# OWL_THERMOPTIC_USERNAME=
# OWL_THERMOPTIC_PASSWORD=
# OWL_THERMOPTIC_TIMEOUT=6
# OWL_THERMOPTIC_PROBE_TTL=30
# Synergy 15: React dashboard at /dashboard (REST + WebSocket metrics)
# ACLAW_METRICS_LOG_CAP=250
# ACLAW_METRICS_WINDOW=60
