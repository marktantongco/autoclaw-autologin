# ─── AutoClaw Environment Variables ─────────────────────────────────
# Copy to /etc/autoclaw/env and set values

# ── App Signing (REQUIRED in production) ──
AUTOCLAW_APP_KEY=

# ── Token Encryption (optional but recommended) ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOCLAW_TOKEN_KEY=

# ── Proxy Server ──
AUTOCLAW_PROXY_HOST=127.0.0.1
AUTOCLAW_PROXY_PORT=31000

# ── TLS Verification ──
AUTOCLAW_TLS_VERIFY=false

# ── Proxy API Key (optional auth for proxy itself) ──
AUTOCLAW_PROXY_API_KEY=

# ── Gunicorn ──
GUNICORN_WORKERS=2
GUNICORN_LOG_LEVEL=info

# ── Synergy 6: OWL-AGENT Proxy Defense Layer (v2.1.0) ──
# Proxy-first upstream routing with hedged racing + direct fallback.
OWL_PROXY_ENABLED=1
# OWL_HEDGE_FANOUT=3
# OWL_PROXY_TIMEOUT=6
# OWL_DIRECT_TIMEOUT=30
# OWL_TLS_IMPERSONATE=chrome110     # requires: pip install curl_cffi
# OWL_CACHE_TTL=0
# OWL_STARTUP_TIMEOUT=15

# ── Phase 2 (v2.2.0): DSML shim + fingerprint + loop_breaker ──
# DSML tool-calling shim (client `tools` synthesised into OpenAI tool_calls)
AUTOCLAW_DSML_ENABLED=1
# Per-chat fingerprint isolation (account affinity, anti conversation-merge)
AUTOCLAW_FINGERPRINT_ENABLED=1
# AUTOCLAW_FINGERPRINT_TTL=86400
# AUTOCLAW_FINGERPRINT_MAX=10000
# loop_breaker: 400s identical re-emits of a >=80%-context-full turn
AUTOCLAW_LOOP_BREAKER_ENABLED=1
# AUTOCLAW_LOOP_REEMITS=4
# AUTOCLAW_LOOP_RATIO=0.8
# AUTOCLAW_LOOP_TTL=3600
# AUTOCLAW_CONTEXT_WINDOW=            # global override (tokens)

# ── Phase 3 (v2.3.0): WS fallback + thermoptic + dashboard ──
# Synergy 13: cloud-to-local WebSocket fallback (requires a local AutoClaw
# desktop agent speaking protocol autoclaw-ws-agent-v1)
ACLAW_WS_FALLBACK=0
# ACLAW_WS_AGENT_URL=ws://127.0.0.1:18789/agent   # skip discovery when set
# ACLAW_WS_DISCOVERY_PORTS=18789,18790,18791
# ACLAW_WS_TIMEOUT=600
# ACLAW_WS_BREAKER_THRESHOLD=3
# ACLAW_WS_BREAKER_COOLDOWN=60
# Synergy 14 (via mandatoryprogrammer/thermoptic): real-browser JA4+
# camouflage egress tier — run deploy/thermoptic-README.md setup first
OWL_THERMOPTIC_ENABLED=0
# OWL_THERMOPTIC_URL=http://127.0.0.1:1234
# OWL_THERMOPTIC_CA=/path/to/thermoptic/ssl/rootCA.crt
# OWL_THERMOPTIC_USERNAME=
# OWL_THERMOPTIC_PASSWORD=
# OWL_THERMOPTIC_TIMEOUT=6
# OWL_THERMOPTIC_PROBE_TTL=30
# Synergy 15: React dashboard at /dashboard (REST + WebSocket metrics)
# ACLAW_METRICS_LOG_CAP=250
# ACLAW_METRICS_WINDOW=60

# ── Phase 3.1 (v2.4.0) ───────────────────────────────────────────────
# Synergy 7: server-first no-CloakBrowser mode (token import lifeline —
# upstream OAuth URL route is 405-deprecated; harvest tokens with the
# desktop app, then import them here)
# ACLAW_NO_BROWSER=0
# Upstream OAuth-URL route is 405-deprecated (live-probed 2026-09-19, differential
# evidence: bad-sign -> 400002 envelope, good-sign -> 405). Browser harvest is dead
# for ALL forks; import is the primary token-supply path. Default to import so the
# proxy hard-fails browser flows (409) deterministically and never burns a dead
# upstream call after restart (auto degrades only after a live probe, and the
# oauth_upstream state resets to "unknown" each boot).
ACLAW_OAUTH_MODE=import          # auto | browser | import | none
# ACLAW_IMPORT_DIR=.autoclaw_imports
# ACLAW_IMPORT_ON_START=1
# ACLAW_IMPORT_FORMAT=auto       # auto | autoclaw2api | desktop-ls | tokens-json
# ACLAW_IMPORT_DEDUPE=email      # email | refresh_token
# ACLAW_APPLOGIN_PROBE=0         # report-only reachability probe for new upstream auth routes
# DSML real-world metrics (schema live in /health + dashboard)
# (no knobs — counters are always on, zero-cost when idle)
# Metrics persistence (telemetry survives restarts)
# ACLAW_METRICS_PERSIST=1
# ACLAW_METRICS_FLUSH_S=30
# ACLAW_METRICS_PERSIST_PATH=data/metrics_state.json
# ACLAW_METRICS_ROLLUP_HOURS=72
# ACLAW_METRICS_CLIENTS_CAP=1000
# ACLAW_DASH_WS_CAP=20

# ── v2.5.0 (SPEC-8b7): dashboard auth surface ────────────────────────
# Fail-closed posture: with AUTOCLAW_PROXY_API_KEY set, /api/dashboard/*
# and the WS stream require Bearer or a session cookie; WITHOUT a key,
# control answers 503 auth_unconfigured (never open) and reads are
# loopback-only. The UI shows a login card and exchanges the key ONCE for
# an HttpOnly SameSite=Strict cookie (8h). WS uses one-time 60s tickets.
# ACLAW_DASH_SESSION_TTL=28800   # session cookie lifetime (seconds)
# ACLAW_DASHBOARD_PUBLIC=0       # 1 = public unauthenticated READS (escape
#                                # hatch; surfaces a warning in /health and
#                                # the UI; control stays 503 regardless)

# ── v2.6.0: Claude credit-tier routing (Synergy 7) ──
# Remote model-config endpoint for tier targets (heuristic fallback if unreachable)
AUTOCLAW_MODEL_CONFIG_URL=https://autoglm-api.autoglm.ai/autoclaw-proxy/proxy/autoclaw-model-config
AUTOCLAW_TIER_REFRESH_S=300

# ── v2.6.1: upstream edge fingerprint ──
# The edge WAF 405-blocks python-requests/* (and empty) User-Agents with an
# HTML challenge page (live-probed 2026-09-21). Every signed upstream request
# carries this UA; override if the app fingerprint moves.
AUTOCLAW_UPSTREAM_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) autoclaw/2.5.0 Chrome/120.0.0.0 Electron/28.0.0 Safari/537.36

# Dev-server log verbosity (gunicorn uses GUNICORN_LOG_LEVEL)
AUTOCLAW_LOG_LEVEL=INFO
